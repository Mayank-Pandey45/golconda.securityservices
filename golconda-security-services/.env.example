# Vercel build-time/browser values. These are public by design; never put a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel runtime-only values. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional local Express development server port.
PORT=4000

# Optional owner-admin Telegram advance entry. Keep server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional identity document encryption key: base64-encoded 32 random bytes.
EMPLOYEE_IDENTITY_ENCRYPTION_KEY=

# Optional Google Sheets advance sync. Leave disabled; keep credentials server-only.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
CRON_SECRET=
