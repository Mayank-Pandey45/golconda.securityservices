# Vercel build-time/browser values. These are public by design; never put a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel runtime-only values. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional local Express development server port.
PORT=4000

# Optional Telegram advance entry. Leave unset during current staging validation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_USER_ID=

# Optional Google Sheets advance sync. Leave disabled; keep credentials server-only.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
CRON_SECRET=
