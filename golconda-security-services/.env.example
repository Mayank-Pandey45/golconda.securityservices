# Vercel build-time/browser values. These are public by design; never put a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel runtime-only values. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend email delivery. EMAIL_FROM must be a verified sender in Resend.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=

# Optional local Express development server port.
PORT=4000
